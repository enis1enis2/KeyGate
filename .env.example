# KeyGate Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Master Encryption Key (used to derive the AES-256-GCM key for upstream API keys at rest).
# REQUIRED when NODE_ENV=production. Generate one instead of inventing text:
#   openssl rand -hex 32
KEYGATE_MASTER_KEY=

# Admin bearer token for /api/* and /metrics. REQUIRED when NODE_ENV=production.
#   openssl rand -hex 32
KEYGATE_ADMIN_TOKEN=

# Optional: previous master key(s), comma-separated, accepted for decryption only while you
# re-encrypt existing rows. Remove them once `npm run reencrypt` reports zero old rows.
KEYGATE_MASTER_KEY_PREVIOUS=

# Authentication
# Set to 'false' only for local offline debugging to bypass Gateway Bearer token checks.
# KeyGate refuses to start with 'false' when NODE_ENV=production.
KEYGATE_REQUIRE_AUTH=true

# Reverse proxy: 'false' (default), 'true' to trust every hop, or a comma-separated list of
# proxy addresses/CIDRs, e.g. 10.0.0.0/8,172.17.0.1. Required behind Traefik/Nginx/Cloudflare
# so rate limiting and request logs see the real client IP.
TRUST_PROXY=false

# Privacy: set to 'false' to stop storing prompt/response snippets in /api/history.
HISTORY_ENABLED=true

# Send Strict-Transport-Security when KeyGate is served over TLS. Defaults to true in production.
ENABLE_HSTS=true

# CORS
# Empty = same-origin only (recommended). Otherwise a comma-separated list of allowed origins,
# e.g. https://admin.example.com,http://localhost:5173
CORS_ORIGINS=

# Rate Limiting
# Global requests per window for every route
RATE_LIMIT_MAX=300
# Requests per window for /v1/chat/completions, /v1/embeddings and /v1/passthrough/*
RATE_LIMIT_V1_MAX=120
# Window length in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Database & Storage
KEYGATE_DB_PATH=./data/keygate.sqlite
# Retention period for request trace logs and metrics (in days)
METRICS_RETENTION_DAYS=30

# Uploads (multipart surfaces: /v1/audio/transcriptions, /v1/images/edits, ...)
# Maximum accepted upload size in bytes. Requests larger than this are rejected with 413.
MAX_UPLOAD_BYTES=67108864

# Circuit Breaker & Health Tuning
# Consecutive failures before opening the circuit
CB_FAILURE_THRESHOLD=3
# Rolling success rate threshold (0.0 to 1.0) under which circuit trips
CB_SUCCESS_RATE_THRESHOLD=0.7
# Exponential backoff base cooldown in ms (e.g. 5000 = 5s)
CB_BASE_COOLDOWN_MS=5000
# Maximum cooldown in ms (e.g. 300000 = 5 minutes)
CB_MAX_COOLDOWN_MS=300000
# Cooldown applied when an upstream provider signals quota_exhausted (e.g. 86400000 = 24 hours)
CB_QUOTA_COOLDOWN_MS=86400000

# Default per-request timeout in ms
DEFAULT_TIMEOUT_MS=30000
